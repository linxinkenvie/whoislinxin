---
interface Props {
	showThemeToggle?: boolean;
	blogHref?: string;
	languageSwitch?: {
		href: string;
		label: string;
		targetLanguage: 'zh' | 'en';
	};
}

const { showThemeToggle = false, blogHref = '/blog/', languageSwitch } = Astro.props;
---

<header class="terminal-bar">
	<div class="window-controls" aria-hidden="true">
		<span></span>
		<span></span>
		<span></span>
	</div>

	<a class="terminal-title" href="/" aria-label="Home">linxin@whoislinxin: ~</a>

	<nav class="top-nav" aria-label="Primary navigation">
		<a href={blogHref}>Blog</a>
		<a href="https://github.com/linxinkenvie" target="_blank" rel="noreferrer">GitHub</a>
		<a href="/about/">About</a>
		<a href="https://x.com/linxinkenvie" target="_blank" rel="noreferrer">X</a>
		{
			showThemeToggle && (
				<button
					id="article-theme-toggle"
					class="theme-toggle"
					type="button"
					aria-label="Toggle color theme"
					title="Toggle color theme"
				>
					◐ Theme
				</button>
			)
		}
		{
			languageSwitch && (
				<a
					class="language-switch"
					href={languageSwitch.href}
					hreflang={languageSwitch.targetLanguage === 'zh' ? 'zh-CN' : 'en'}
					data-language-choice={languageSwitch.targetLanguage}
					aria-label={languageSwitch.targetLanguage === 'zh' ? '切换到中文' : 'Switch to English'}
				>
					{languageSwitch.label}
				</a>
			)
		}
	</nav>
</header>

<style>
	.terminal-bar {
		height: 48px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 16px;
		box-sizing: border-box;
		background: #161b22;
		border-bottom: 1px solid #282f38;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		user-select: none;
	}

	.window-controls {
		display: flex;
		gap: 8px;
	}

	.window-controls span {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.window-controls span:nth-child(1) {
		background: #ff5f57;
	}

	.window-controls span:nth-child(2) {
		background: #febc2e;
	}

	.window-controls span:nth-child(3) {
		background: #28c840;
	}

	.terminal-title {
		color: #8b949e;
		font-size: 0.8rem;
		text-decoration: none;
	}

	.terminal-title:hover,
	.terminal-title:focus-visible {
		color: #9aa4b2;
	}

	.terminal-title:focus-visible {
		outline: none;
		text-decoration: underline;
	}

	.top-nav {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 1.35rem;
		white-space: nowrap;
	}

	.top-nav a {
		color: #9aa4b2;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			color 120ms ease,
			text-shadow 120ms ease;
	}

	.theme-toggle {
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #9aa4b2;
		cursor: pointer;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		white-space: nowrap;
		transition:
			color 120ms ease,
			text-shadow 120ms ease;
	}

	.top-nav a:hover,
	.top-nav a:focus-visible,
	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		color: #7ee787;
		text-shadow: 0 0 8px rgb(126 231 135 / 0.25);
	}

	.top-nav a:focus-visible {
		outline: none;
		text-decoration: underline;
	}

	.theme-toggle:focus-visible {
		outline: 1px solid #7ee787;
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.terminal-bar {
			height: auto;
			min-height: 48px;
			grid-template-columns: auto 1fr;
			grid-template-rows: 48px auto;
			padding-bottom: 8px;
		}

		.terminal-title {
			justify-self: end;
		}

		.top-nav {
			grid-column: 1 / -1;
			width: 100%;
			justify-content: flex-end;
			gap: 1.1rem;
			padding-right: 2px;
			box-sizing: border-box;
		}

		.top-nav a {
			font-size: 0.8rem;
		}

		.theme-toggle {
			font-size: 0.8rem;
		}
	}
</style>
