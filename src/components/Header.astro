---
import TerminalHeader from './TerminalHeader.astro';

interface Props {
	showThemeToggle?: boolean;
	blogHref?: string;
	languageSwitch?: {
		href: string;
		label: string;
		targetLanguage: 'zh' | 'en';
	};
}

const { showThemeToggle = false, blogHref = '/blog/', languageSwitch } = Astro.props;
---

<TerminalHeader {showThemeToggle} {blogHref} {languageSwitch} />
