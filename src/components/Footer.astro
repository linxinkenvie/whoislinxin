---
interface Props {
	theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const today = new Date();
---

<footer class:list={{ dark: theme === 'dark' }}>
	<p>&copy; {today.getFullYear()} Linxin.</p>
	<p class="meta">
		<a href="https://github.com/linxinkenvie" target="_blank" rel="noreferrer">
			GitHub
		</a>
		<span> · </span>
		<span>whoislinxin.com</span>
	</p>
</footer>

<style>
	footer {
		padding: 1.2rem 1rem 2rem;
		border-top: 1px solid #eceef0;
		background: #fafafa;
		color: #929aa3;
		font-size: 0.78rem;
		line-height: 1.5;
		text-align: center;
	}

	footer.dark {
		border-top-color: var(--feature-rule, #202020);
		background: var(--feature-bg, #000);
		color: var(--feature-meta, #777);
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	footer p {
		margin: 0.15rem 0;
	}

	.meta {
		font-size: 0.9em;
	}

	.meta a {
		color: inherit;
		text-decoration: none;
	}

	.meta a:hover {
		color: #2f6b95;
		text-decoration: underline;
	}

	.dark .meta a:hover {
		color: #7ee787;
	}
</style>
