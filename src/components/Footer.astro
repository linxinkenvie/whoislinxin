---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Linxin.</p>
	<p class="meta">
		<a href="https://github.com/linxinkenvie" target="_blank" rel="noreferrer">
			GitHub
		</a>
		<span> · </span>
		<span>whoislinxin.com</span>
	</p>
</footer>

<style>
	footer {
		padding: 2em 1em 4em;
		border-top: 1px solid #e2e5e8;
		background: #fafafa;
		color: #737d88;
		text-align: center;
	}

	footer p {
		margin: 0.35em 0;
	}

	.meta {
		font-size: 0.9em;
	}

	.meta a {
		color: inherit;
		text-decoration: none;
	}

	.meta a:hover {
		color: #2f6b95;
		text-decoration: underline;
	}
</style>
