---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Linxin.</p>
	<p class="meta">
		<a href="https://github.com/linxinkenvie" target="_blank" rel="noreferrer">
			GitHub
		</a>
		<span> · </span>
		<span>whoislinxin.com</span>
	</p>
</footer>

<style>
	footer {
		padding: 1.2rem 1rem 2rem;
		border-top: 1px solid #eceef0;
		background: #fafafa;
		color: #929aa3;
		font-size: 0.78rem;
		line-height: 1.5;
		text-align: center;
	}

	footer p {
		margin: 0.15rem 0;
	}

	.meta {
		font-size: 0.9em;
	}

	.meta a {
		color: inherit;
		text-decoration: none;
	}

	.meta a:hover {
		color: #2f6b95;
		text-decoration: underline;
	}
</style>
