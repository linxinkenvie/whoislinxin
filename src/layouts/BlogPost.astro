---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	theme = 'default',
	eyebrow,
	displayTitle,
	lang = 'en',
	translationKey,
} = Astro.props;
const pagePath = `~${Astro.url.pathname.replace(/\/$/, '')}`;
const isBlogPost = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/';
const isFeatureArticle = theme === 'feature';
const currentLanguage: 'zh' | 'en' = lang === 'zh-CN' ? 'zh' : 'en';
const chinesePath = translationKey ? `/blog/${translationKey}/` : undefined;
const englishPath = translationKey ? `/blog/${translationKey}/en/` : undefined;
const targetLanguage: 'zh' | 'en' = currentLanguage === 'zh' ? 'en' : 'zh';
const languageSwitch =
	chinesePath && englishPath
		? {
				href: targetLanguage === 'zh' ? chinesePath : englishPath,
				label: targetLanguage === 'zh' ? '中文' : 'EN',
				targetLanguage,
			}
		: undefined;
const blogHref = currentLanguage === 'en' ? '/blog/en/' : '/blog/';
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		{chinesePath && <link rel="alternate" hreflang="zh-CN" href={new URL(chinesePath, Astro.site)} />}
		{englishPath && <link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.site)} />}
		{englishPath && <link rel="alternate" hreflang="x-default" href={new URL(englishPath, Astro.site)} />}
		{isFeatureArticle && <script is:inline src="/scripts/article-theme.js"></script>}
		{
			chinesePath && englishPath && (
				<script
					is:inline
					src="/scripts/article-language.js"
					data-current-language={currentLanguage}
					data-chinese-path={chinesePath}
					data-english-path={englishPath}
				></script>
			)
		}
	</head>

	<body class:list={{ 'feature-article': isFeatureArticle }}>
		<Header showThemeToggle={isFeatureArticle} {blogHref} {languageSwitch} />

		<div class="page-shell">
			{isBlogPost && (
				<a
					class="back-to-blog"
					href="/blog/"
					aria-label="Back to blog"
					aria-keyshortcuts="Escape"
					title="Back to blog (Esc)"
				>
					←
				</a>
			)}

			<main class="article-shell">
				<article>
					<header class="article-header">
						<p class="article-path">{pagePath}</p>
						<h1>
							{displayTitle ? displayTitle.map((line) => <span class="title-line">{line}</span>) : title}
						</h1>
						<div class="article-meta">
							<FormattedDate date={pubDate} />
							{eyebrow && <span class="article-eyebrow">{eyebrow}</span>}
							{
								updatedDate && (
									<span>
										Updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						{isFeatureArticle && <p class="article-description">{description}</p>}
					</header>

					{heroImage && (
						<figure class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</figure>
					)}

					<div class="prose">
						<slot />
					</div>
				</article>
			</main>
		</div>

		<Footer theme={isFeatureArticle ? 'dark' : 'light'} />

		{isBlogPost && <script is:inline src="/scripts/blog-shortcuts.js" defer></script>}
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		min-height: 100%;
		background: #fafafa;
	}

	:global(body) {
		color: #1b1f23;
	}

	.page-shell {
		position: relative;
	}

	.back-to-blog {
		position: absolute;
		top: 16px;
		left: 18px;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 6px;
		color: #8b949e;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: 1.35rem;
		text-decoration: none;
		transition:
			color 120ms ease,
			background 120ms ease;
	}

	.back-to-blog:hover,
	.back-to-blog:focus-visible {
		background: rgb(126 231 135 / 0.08);
		color: #7ee787;
	}

	.back-to-blog:focus-visible {
		outline: 1px solid #7ee787;
	}

	.article-shell {
		width: 760px;
		max-width: calc(100% - 40px);
		box-sizing: border-box;
		margin: 0 auto;
		padding: 72px 0 96px;
	}

	.article-header {
		margin-bottom: 3rem;
	}

	.article-path {
		margin: 0 0 1.2rem;
		color: #7b8490;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: 0.82rem;
		overflow-wrap: anywhere;
	}

	.article-header h1 {
		margin: 0 0 1.25rem;
		color: #1b1f23;
		font-size: clamp(2.65rem, 7vw, 4.6rem);
		letter-spacing: -0.045em;
		line-height: 1.02;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.25rem;
		color: #737d88;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: 0.82rem;
	}

	.article-description {
		display: none;
	}

	.hero-image {
		margin: 0 0 3rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}

	.prose {
		color: #262b31;
		font-size: 1.12rem;
		line-height: 1.78;
	}

	:global(.prose > :first-child) {
		margin-top: 0;
	}

	:global(.prose p) {
		margin: 0 0 1.55em;
	}

	:global(.prose h2),
	:global(.prose h3),
	:global(.prose h4) {
		color: #1b1f23;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	:global(.prose h2) {
		margin: 2.25em 0 0.75em;
		font-size: 2rem;
	}

	:global(.prose h3) {
		margin: 2em 0 0.65em;
		font-size: 1.5rem;
	}

	:global(.prose a) {
		color: #2f6b95;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.16em;
	}

	:global(.prose a:hover),
	:global(.prose a:focus-visible) {
		color: #174f78;
	}

	:global(.prose code) {
		border-radius: 3px;
		background: #e9edf0;
		padding: 0.14em 0.34em;
		color: #20252a;
		font-size: 0.9em;
	}

	:global(.prose pre) {
		margin: 2rem 0;
		border: 1px solid #252c34;
		border-radius: 5px;
		background: #090c10;
		padding: 1.35rem 1.5rem;
		color: #d7dde5;
		overflow-x: auto;
		line-height: 1.65;
	}

	:global(.prose pre code) {
		background: transparent;
		padding: 0;
		color: inherit;
		font-size: 0.9rem;
	}

	:global(.prose blockquote) {
		margin: 2rem 0;
		border-left: 3px solid #79a9cb;
		padding: 0.2rem 0 0.2rem 1.25rem;
		color: #515b65;
		font-size: 1.08rem;
	}

	:global(.prose ul),
	:global(.prose ol) {
		margin: 0 0 1.55em;
		padding-left: 1.4em;
	}

	:global(.prose li) {
		margin-bottom: 0.45em;
	}

	:global(.prose img) {
		display: block;
		margin: 2rem auto;
		border-radius: 4px;
	}

	:global(.prose hr) {
		margin: 3rem 0;
		border: 0;
		border-top: 1px solid #dfe2e5;
	}

	:global(body.feature-article) {
		--feature-bg: #000;
		--feature-text: #f1f1f1;
		--feature-heading: #fff;
		--feature-muted: #b8b8b8;
		--feature-meta: #8a8a8a;
		--feature-meta-strong: #a5a5a5;
		--feature-code-bg: #181818;
		--feature-quote: #c7c7c7;
		--feature-rule: #2a2a2a;
		--feature-link: #a8c7fa;
		--feature-link-hover: #d3e3fd;
		--feature-control: #777;
		--feature-control-hover: #f5f5f5;

		background: var(--feature-bg);
		color: var(--feature-text);
		color-scheme: dark;
	}

	:global(html[data-article-theme='light'] body.feature-article) {
		--feature-bg: #fff;
		--feature-text: #171717;
		--feature-heading: #000;
		--feature-muted: #4f4f4f;
		--feature-meta: #696969;
		--feature-meta-strong: #4d4d4d;
		--feature-code-bg: #f1f1f1;
		--feature-quote: #444;
		--feature-rule: #dedede;
		--feature-link: #285f8f;
		--feature-link-hover: #153f64;
		--feature-control: #777;
		--feature-control-hover: #111;

		color-scheme: light;
	}

	:global(body.feature-article) .page-shell {
		background: var(--feature-bg);
		transition: background-color 160ms ease;
	}

	:global(body.feature-article) .back-to-blog {
		color: var(--feature-control);
	}

	:global(body.feature-article) .back-to-blog:hover,
	:global(body.feature-article) .back-to-blog:focus-visible {
		background: rgb(126 231 135 / 0.08);
		color: #7ee787;
	}

	:global(body.feature-article) .article-shell {
		width: 1120px;
		max-width: calc(100% - 40px);
		padding: 0 0 120px;
	}

	:global(body.feature-article) .article-header {
		min-height: min(720px, calc(100svh - 48px));
		box-sizing: border-box;
		margin: 0;
		padding: 72px 0 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	:global(body.feature-article) .article-path {
		display: none;
	}

	:global(body.feature-article) .article-header h1 {
		max-width: 900px;
		margin: 0 0 2rem;
		color: var(--feature-heading);
		font-size: clamp(3rem, 4.7vw, 4.75rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.02;
		text-wrap: balance;
	}

	:global(.title-line) {
		display: block;
	}

	:global(.title-line + .title-line) {
		transform: translateX(clamp(8px, 1.5vw, 20px));
	}

	:global(body.feature-article) .article-meta {
		order: -1;
		justify-content: center;
		margin-bottom: 2.6rem;
		color: var(--feature-meta);
		font-family: var(--font-atkinson);
		font-size: 0.88rem;
		letter-spacing: 0;
	}

	:global(body.feature-article) .article-eyebrow {
		color: var(--feature-meta-strong);
	}

	:global(body.feature-article) .article-description {
		display: block;
		max-width: 620px;
		margin: 0;
		color: var(--feature-muted);
		font-size: clamp(1.08rem, 1.8vw, 1.28rem);
		line-height: 1.55;
	}

	:global(body.feature-article) .prose {
		width: 620px;
		max-width: 100%;
		margin: 0 auto;
		color: var(--feature-text);
		font-size: 1.075rem;
		line-height: 1.84;
	}

	:global(body.feature-article .prose p) {
		margin-bottom: 1.8em;
	}

	:global(body.feature-article .prose h2),
	:global(body.feature-article .prose h3),
	:global(body.feature-article .prose h4) {
		color: var(--feature-heading);
		font-weight: 400;
	}

	:global(body.feature-article .prose h2) {
		margin: 3.5em 0 1em;
		font-size: clamp(2rem, 4vw, 3rem);
	}

	:global(body.feature-article .prose a) {
		color: var(--feature-link);
	}

	:global(body.feature-article .prose a:hover),
	:global(body.feature-article .prose a:focus-visible) {
		color: var(--feature-link-hover);
	}

	:global(body.feature-article .prose code) {
		background: var(--feature-code-bg);
		color: var(--feature-text);
	}

	:global(body.feature-article .prose blockquote) {
		border-left-color: #565656;
		color: var(--feature-quote);
	}

	:global(body.feature-article .prose hr) {
		margin: 5rem 0;
		border-top-color: var(--feature-rule);
	}

	:global(body.feature-article .prose img) {
		position: relative;
		left: 50%;
		width: auto;
		max-width: min(960px, calc(100vw - 40px));
		margin: 4.5rem 0;
		border-radius: 0;
		transform: translateX(-50%);
	}

	@media (max-width: 640px) {
		.back-to-blog {
			top: 10px;
			left: 10px;
		}

		.article-shell {
			max-width: calc(100% - 32px);
			padding: 48px 0 72px;
		}

		.article-header {
			margin-bottom: 2.4rem;
		}

		.prose {
			font-size: 1.04rem;
		}

		:global(.prose pre) {
			margin-right: -4px;
			margin-left: -4px;
			padding: 1.1rem;
		}

		:global(body.feature-article) .article-shell {
			max-width: calc(100% - 32px);
			padding: 0 0 80px;
		}

		:global(body.feature-article) .article-header {
			min-height: calc(100svh - 88px);
			padding: 56px 8px 72px;
		}

		:global(body.feature-article) .article-header h1 {
			margin-bottom: 1.5rem;
			font-size: clamp(2.5rem, 10.5vw, 3.5rem);
		}

		:global(body.feature-article) .article-meta {
			margin-bottom: 2rem;
		}

		:global(body.feature-article) .article-description {
			max-width: 320px;
			font-size: 1.05rem;
		}

		:global(body.feature-article) .prose {
			font-size: 1.04rem;
			line-height: 1.82;
		}

		:global(body.feature-article .prose img) {
			max-width: calc(100vw - 24px);
			margin-top: 3rem;
			margin-bottom: 3rem;
		}

		:global(body.feature-article .prose hr) {
			margin: 3.5rem 0;
		}
	}
</style>
