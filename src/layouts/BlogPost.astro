---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const pagePath = `~${Astro.url.pathname.replace(/\/$/, '')}`;
const isBlogPost = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<div class="page-shell">
			{isBlogPost && (
				<a
					class="back-to-blog"
					href="/blog/"
					aria-label="Back to blog"
					aria-keyshortcuts="Escape"
					title="Back to blog (Esc)"
				>
					←
				</a>
			)}

			<main class="article-shell">
				<article>
					<header class="article-header">
						<p class="article-path">{pagePath}</p>
						<h1>{title}</h1>
						<div class="article-meta">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span>
										Updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
					</header>

					{heroImage && (
						<figure class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</figure>
					)}

					<div class="prose">
						<slot />
					</div>
				</article>
			</main>
		</div>

		<Footer />

		{isBlogPost && <script is:inline src="/scripts/blog-shortcuts.js" defer></script>}
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		min-height: 100%;
		background: #fafafa;
	}

	:global(body) {
		color: #1b1f23;
	}

	.page-shell {
		position: relative;
	}

	.back-to-blog {
		position: absolute;
		top: 16px;
		left: 18px;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 6px;
		color: #8b949e;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: 1.35rem;
		text-decoration: none;
		transition:
			color 120ms ease,
			background 120ms ease;
	}

	.back-to-blog:hover,
	.back-to-blog:focus-visible {
		background: rgb(126 231 135 / 0.08);
		color: #7ee787;
	}

	.back-to-blog:focus-visible {
		outline: 1px solid #7ee787;
	}

	.article-shell {
		width: 760px;
		max-width: calc(100% - 40px);
		box-sizing: border-box;
		margin: 0 auto;
		padding: 72px 0 96px;
	}

	.article-header {
		margin-bottom: 3rem;
	}

	.article-path {
		margin: 0 0 1.2rem;
		color: #7b8490;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: 0.82rem;
		overflow-wrap: anywhere;
	}

	.article-header h1 {
		margin: 0 0 1.25rem;
		color: #1b1f23;
		font-size: clamp(2.65rem, 7vw, 4.6rem);
		letter-spacing: -0.045em;
		line-height: 1.02;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.25rem;
		color: #737d88;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: 0.82rem;
	}

	.hero-image {
		margin: 0 0 3rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}

	.prose {
		color: #262b31;
		font-size: 1.12rem;
		line-height: 1.78;
	}

	:global(.prose > :first-child) {
		margin-top: 0;
	}

	:global(.prose p) {
		margin: 0 0 1.55em;
	}

	:global(.prose h2),
	:global(.prose h3),
	:global(.prose h4) {
		color: #1b1f23;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	:global(.prose h2) {
		margin: 2.25em 0 0.75em;
		font-size: 2rem;
	}

	:global(.prose h3) {
		margin: 2em 0 0.65em;
		font-size: 1.5rem;
	}

	:global(.prose a) {
		color: #2f6b95;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.16em;
	}

	:global(.prose a:hover),
	:global(.prose a:focus-visible) {
		color: #174f78;
	}

	:global(.prose code) {
		border-radius: 3px;
		background: #e9edf0;
		padding: 0.14em 0.34em;
		color: #20252a;
		font-size: 0.9em;
	}

	:global(.prose pre) {
		margin: 2rem 0;
		border: 1px solid #252c34;
		border-radius: 5px;
		background: #090c10;
		padding: 1.35rem 1.5rem;
		color: #d7dde5;
		overflow-x: auto;
		line-height: 1.65;
	}

	:global(.prose pre code) {
		background: transparent;
		padding: 0;
		color: inherit;
		font-size: 0.9rem;
	}

	:global(.prose blockquote) {
		margin: 2rem 0;
		border-left: 3px solid #79a9cb;
		padding: 0.2rem 0 0.2rem 1.25rem;
		color: #515b65;
		font-size: 1.08rem;
	}

	:global(.prose ul),
	:global(.prose ol) {
		margin: 0 0 1.55em;
		padding-left: 1.4em;
	}

	:global(.prose li) {
		margin-bottom: 0.45em;
	}

	:global(.prose img) {
		display: block;
		margin: 2rem auto;
		border-radius: 4px;
	}

	:global(.prose hr) {
		margin: 3rem 0;
		border: 0;
		border-top: 1px solid #dfe2e5;
	}

	@media (max-width: 640px) {
		.back-to-blog {
			top: 10px;
			left: 10px;
		}

		.article-shell {
			max-width: calc(100% - 32px);
			padding: 48px 0 72px;
		}

		.article-header {
			margin-bottom: 2.4rem;
		}

		.prose {
			font-size: 1.04rem;
		}

		:global(.prose pre) {
			margin-right: -4px;
			margin-left: -4px;
			padding: 1.1rem;
		}
	}
</style>
