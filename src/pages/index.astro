---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<main class="terminal-window">
			<header class="terminal-bar">
				<div class="window-controls" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</div>

				<div class="terminal-title">
					linxin@whoislinxin: ~
				</div>

				<div class="terminal-spacer"></div>
			</header>

			<section class="terminal">
				<div id="boot-output">
					<div class="terminal-intro">
						<div class="profile-output">
							<div class="command">
								<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
								<span>whois linxin</span>
							</div>

							<div class="output whois-output">
								<div class="field">
									<span class="label">NAME</span>
									<span>Linxin</span>
								</div>

								<div class="field">
									<span class="label">STATUS</span>
									<span>Building things.</span>
								</div>

								<div class="field">
									<span class="label">INTERESTS</span>
									<span>AI / Programming Languages / Linux</span>
								</div>

								<div class="field">
									<span class="label">DOMAIN</span>
									<span>whoislinxin.com</span>
								</div>
							</div>
						</div>

						<aside class="ascii-brand" aria-hidden="true">
							<pre class="ascii-logo">██╗    ██╗██╗  ██╗ ██████╗ ██╗███████╗
██║    ██║██║  ██║██╔═══██╗██║██╔════╝
██║ █╗ ██║███████║██║   ██║██║███████╗
██║███╗██║██╔══██║██║   ██║██║╚════██║
╚███╔███╔╝██║  ██║╚██████╔╝██║███████║
 ╚══╝╚══╝ ╚═╝  ╚═╝ ╚═════╝ ╚═╝╚══════╝</pre>
							<div class="ascii-tagline">WHO IS LINXIN?</div>
						</aside>
					</div>

					<div class="command">
						<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
						<span>ls</span>
					</div>

					<nav class="output directory-list" aria-label="Site navigation">
						<a href="/blog/">blog/</a>
						<a href="/about/">about/</a>
						<a href="https://github.com/linxinkenvie" target="_blank" rel="noreferrer">github/</a>
					</nav>
				</div>

				<div id="terminal-history" aria-live="polite"></div>

				<form id="terminal-form" class="command current-line" autocomplete="off">
					<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
					<label class="input-shell">
						<span class="sr-only">Enter a terminal command</span>
						<input
							id="terminal-input"
							class="terminal-input"
							type="text"
							placeholder=" "
							autocapitalize="none"
							spellcheck="false"
							aria-label="Terminal command"
						/>
						<span class="cursor" aria-hidden="true"></span>
					</label>
				</form>
			</section>
		</main>
	</body>
</html>

<script>
	const initializeTerminal = () => {
		const terminal = document.querySelector<HTMLElement>('.terminal');
		const form = document.querySelector<HTMLFormElement>('#terminal-form');
		const input = document.querySelector<HTMLInputElement>('#terminal-input');
		const bootOutput = document.querySelector<HTMLElement>('#boot-output');
		const historyOutput = document.querySelector<HTMLElement>('#terminal-history');

		if (!terminal || !form || !input || !bootOutput || !historyOutput) return;

		const commandHistory: string[] = [];
		let historyIndex = 0;

		const createSpan = (className: string, text: string) => {
			const span = document.createElement('span');
			span.className = className;
			span.textContent = text;
			return span;
		};

		const appendCommand = (command: string) => {
			const row = document.createElement('div');
			row.className = 'history-command';
			row.append(
				createSpan('history-user', 'linxin@whoislinxin'),
				createSpan('history-separator', ':'),
				createSpan('history-path', '~'),
				createSpan('history-prompt', '$'),
				createSpan('history-command-text', command),
			);
			historyOutput.append(row);
		};

		const appendLines = (lines: string[], tone: 'default' | 'muted' | 'success' | 'error' = 'default') => {
			const block = document.createElement('div');
			block.className = `history-output history-${tone}`;

			for (const line of lines) {
				const row = document.createElement('div');
				row.textContent = line || '\u00a0';
				block.append(row);
			}

			historyOutput.append(block);
		};

		const appendDirectoryList = () => {
			const nav = document.createElement('nav');
			nav.className = 'history-output history-directory-list';
			nav.setAttribute('aria-label', 'Command output destinations');

			for (const destination of [
				{ label: 'blog/', href: '/blog/' },
				{ label: 'about/', href: '/about/' },
				{ label: 'github/', href: 'https://github.com/linxinkenvie', external: true },
			]) {
				const link = document.createElement('a');
				link.textContent = destination.label;
				link.href = destination.href;
				if (destination.external) {
					link.target = '_blank';
					link.rel = 'noreferrer';
				}
				nav.append(link);
			}

			historyOutput.append(nav);
		};

		const navigateTo = (path: string) => {
			appendLines([`→ ${path}`], 'success');
			window.setTimeout(() => window.location.assign(path), 180);
		};

		const openGitHub = () => {
			const url = 'https://github.com/linxinkenvie';
			appendLines([`→ ${url}`], 'success');
			const newWindow = window.open(url, '_blank', 'noopener,noreferrer');
			if (newWindow) newWindow.opener = null;
		};

		const runCommand = (rawCommand: string) => {
			const normalized = rawCommand.toLowerCase().replace(/\s+/g, ' ').replace(/\/+$/, '');

			if (normalized === 'clear') {
				bootOutput.hidden = true;
				historyOutput.replaceChildren();
				return;
			}

			appendCommand(rawCommand);

			switch (normalized) {
				case 'help':
					appendLines([
						'Available commands:',
						'  whois linxin    display profile',
						'  ls              list destinations',
						'  pwd             print working directory',
						'  cd blog         open blog',
						'  cd about        open about page',
						'  cat about       show a short bio',
						'  github          open GitHub',
						'  open github     open GitHub',
						'  clear           clear terminal',
					]);
					break;

				case 'whois':
				case 'whois linxin':
					appendLines([
						'NAME        Linxin',
						'STATUS      Building things.',
						'INTERESTS   AI / Programming Languages / Linux',
						'DOMAIN      whoislinxin.com',
					]);
					break;

				case 'ls':
					appendDirectoryList();
					break;

				case 'pwd':
					appendLines(['/home/linxin']);
					break;

				case 'cat about':
					appendLines([
						'Linxin',
						'Building things with AI, programming languages, and Linux.',
						'Home: whoislinxin.com',
					]);
					break;

				case 'cd blog':
					navigateTo('/blog/');
					break;

				case 'cd about':
					navigateTo('/about/');
					break;

				case 'github':
				case 'open github':
					openGitHub();
					break;

				default:
					appendLines([
						`command not found: ${rawCommand}`,
						'type "help" to list available commands',
					], 'error');
			}

			historyOutput.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const command = input.value.trim();
			input.value = '';

			if (!command) return;

			commandHistory.push(command);
			historyIndex = commandHistory.length;
			runCommand(command);
		});

		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter') {
				event.preventDefault();
				form.requestSubmit();
				return;
			}

			if (event.key === 'ArrowUp') {
				event.preventDefault();
				historyIndex = Math.max(0, historyIndex - 1);
				input.value = commandHistory[historyIndex] ?? '';
				input.setSelectionRange(input.value.length, input.value.length);
			}

			if (event.key === 'ArrowDown') {
				event.preventDefault();
				historyIndex = Math.min(commandHistory.length, historyIndex + 1);
				input.value = commandHistory[historyIndex] ?? '';
				input.setSelectionRange(input.value.length, input.value.length);
			}
		});

		terminal.addEventListener('pointerdown', (event) => {
			if (event.target instanceof HTMLAnchorElement || event.target === input) return;
			window.requestAnimationFrame(() => input.focus({ preventScroll: true }));
		});

		if (window.matchMedia('(pointer: fine)').matches) {
			input.focus({ preventScroll: true });
		}

		form.dataset.terminalReady = 'true';
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeTerminal, { once: true });
	} else {
		initializeTerminal();
	}
</script>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #090c10;
	}

	:global(body) {
		color: #d7dde5;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
	}

	.terminal-window {
		width: 100%;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		background: #090c10;
	}

	.terminal-bar {
		height: 48px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 16px;
		background: #161b22;
		border-bottom: 1px solid #282f38;
		user-select: none;
	}

	.window-controls {
		display: flex;
		gap: 8px;
	}

	.window-controls span {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #525a66;
	}

	.window-controls span:nth-child(1) {
		background: #ff5f57;
	}

	.window-controls span:nth-child(2) {
		background: #febc2e;
	}

	.window-controls span:nth-child(3) {
		background: #28c840;
	}

	.terminal-title {
		color: #8b949e;
		font-size: 0.8rem;
	}

	.terminal {
		width: 100%;
		box-sizing: border-box;
		padding: 90px clamp(32px, 7vw, 120px) 120px;
		flex: 1;
		font-size: clamp(1rem, 1.15vw, 1.25rem);
		line-height: 1.75;
	}

	.terminal-intro {
		display: grid;
		grid-template-columns: minmax(520px, 0.95fr) minmax(480px, 1.05fr);
		gap: clamp(48px, 6vw, 112px);
		align-items: start;
	}

	.profile-output {
		min-width: 0;
	}

	.ascii-brand {
		min-width: 0;
		padding-top: 4px;
		display: flex;
		flex-direction: column;
		align-items: center;
		color: #484f58;
		user-select: none;
	}

	.ascii-logo {
		margin: 0;
		font: inherit;
		font-size: clamp(0.7rem, 0.85vw, 1rem);
		font-weight: 700;
		line-height: 1.35;
		white-space: pre;
	}

	.ascii-tagline {
		margin-top: 18px;
		color: #7ee787;
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.32em;
	}

	.command {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		margin: 0 0 22px;
	}

	.user {
		color: #7ee787;
		font-weight: 700;
	}

	.separator {
		color: #8b949e;
	}

	.path {
		color: #79c0ff;
		font-weight: 700;
	}

	.prompt {
		color: #d2a8ff;
		margin-right: 0.65rem;
	}

	.output {
		margin: 0 0 46px;
		padding-left: 24px;
	}

	.whois-output {
		display: grid;
		gap: 10px;
	}

	.field {
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 20px;
	}

	.label {
		color: #8b949e;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.directory-list {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
	}

	.directory-list a {
		color: #79c0ff;
		font-weight: 700;
		text-decoration: none;
	}

	.directory-list a:hover {
		color: #a5d6ff;
		text-decoration: underline;
	}

	.current-line {
		margin-bottom: 0;
		flex-wrap: nowrap;
		cursor: text;
	}

	.input-shell {
		position: relative;
		min-width: 5rem;
		flex: 1;
		display: flex;
		align-items: center;
	}

	.terminal-input {
		width: 100%;
		min-width: 0;
		height: 1.75em;
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: #d7dde5;
		font: inherit;
		line-height: inherit;
		caret-color: #d7dde5;
	}

	.terminal-input:placeholder-shown {
		caret-color: transparent;
	}

	.terminal-input:not(:placeholder-shown) + .cursor {
		display: none;
	}

	.cursor {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.65em;
		height: 1.15em;
		display: inline-block;
		transform: translateY(-50%);
		background: #d7dde5;
		animation: blink 1s steps(1) infinite;
	}

	:global(#terminal-history .history-command) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		margin: 0 0 8px;
	}

	:global(#terminal-history .history-user) {
		color: #7ee787;
		font-weight: 700;
	}

	:global(#terminal-history .history-separator) {
		color: #8b949e;
	}

	:global(#terminal-history .history-path) {
		color: #79c0ff;
		font-weight: 700;
	}

	:global(#terminal-history .history-prompt) {
		margin-right: 0.65rem;
		color: #d2a8ff;
	}

	:global(#terminal-history .history-output) {
		margin: 0 0 30px;
		padding-left: 24px;
		white-space: pre-wrap;
	}

	:global(#terminal-history .history-directory-list) {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
	}

	:global(#terminal-history .history-directory-list a) {
		color: #79c0ff;
		font-weight: 700;
		text-decoration: none;
	}

	:global(#terminal-history .history-directory-list a:hover) {
		color: #a5d6ff;
		text-decoration: underline;
	}

	:global(#terminal-history .history-success) {
		color: #7ee787;
	}

	:global(#terminal-history .history-muted) {
		color: #8b949e;
	}

	:global(#terminal-history .history-error) {
		color: #ff7b72;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (max-width: 1240px) {
		.terminal-intro {
			display: block;
		}

		.ascii-brand {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.terminal-bar {
			grid-template-columns: auto 1fr;
		}

		.terminal-title {
			text-align: right;
		}

		.terminal-spacer {
			display: none;
		}

		.terminal {
			padding: 48px 16px 80px;
		}

		.field {
			grid-template-columns: 1fr;
			gap: 0;
			margin-bottom: 10px;
		}

		.output {
			padding-left: 12px;
		}

		:global(#terminal-history .history-output) {
			padding-left: 12px;
		}

		.directory-list {
			gap: 20px;
		}

		:global(#terminal-history .history-directory-list) {
			gap: 20px;
		}
	}
</style>
