---
import BaseHead from '../components/BaseHead.astro';
import TerminalHeader from '../components/TerminalHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<main class="terminal-window">
			<TerminalHeader />

			<pre class="ghost-text" aria-hidden="true"><span class="ghost-shell">linxin@whoislinxin:~$ whois --deep linxin &amp;</span>
<span class="ghost-ascii">[1] 42069

 __        ___   _  ___
 \ \      / / | | |/ _ \
  \ \ /\ / /| |_| | | | |
   \ V  V / |  _  | |_| |
    \_/\_/  |_| |_|\___/

 THE FUCK IS LINXIN?</span>

<span class="ghost-status">[still waiting for answer<span class="waiting-dots"></span>]</span></pre>

			<section class="terminal">
				<div id="boot-output">
					<div class="command">
						<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
						<span>whois linxin</span>
					</div>

					<div class="output whois-output">
						<div class="field">
							<span class="label">NAME</span>
							<span>Linxin</span>
						</div>

						<div class="field">
							<span class="label">STATUS</span>
							<span>Building things.</span>
						</div>

						<div class="field">
							<span class="label">INTERESTS</span>
							<span>AI / Programming Languages / Linux</span>
						</div>

						<div class="field">
							<span class="label">DOMAIN</span>
							<span>whoislinxin.com</span>
						</div>
					</div>

					<div class="command">
						<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
						<span>progress</span>
					</div>

					<div class="output progress-output">
						<div class="progress-row">
							<span class="progress-name">NEW ERAS</span>
							<div
								class="progress-track"
								role="progressbar"
								aria-label="New eras"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="18"
							>
								<div class="progress-fill progress-18"></div>
							</div>
							<span class="progress-value">18%</span>
						</div>

						<div class="progress-row">
							<span class="progress-name">ART</span>
							<div
								class="progress-track"
								role="progressbar"
								aria-label="Art"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="1"
							>
								<div class="progress-fill progress-1"></div>
							</div>
							<span class="progress-value">1%</span>
						</div>

						<div class="progress-row">
							<span class="progress-name">MUSIC</span>
							<div
								class="progress-track"
								role="progressbar"
								aria-label="Music"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
							>
								<div class="progress-fill progress-0"></div>
							</div>
							<span class="progress-value">0%</span>
						</div>

						<div class="progress-row">
							<span class="progress-name">LIFE EXPERIENCE</span>
							<div
								class="progress-track infinite-track"
								role="progressbar"
								aria-label="Life experience"
								aria-valuetext="No end"
							>
								<div class="infinite-bar"></div>
							</div>
							<span class="progress-value no-end">NO END</span>
						</div>
					</div>

					<div class="command">
						<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
						<span>ls</span>
					</div>

					<nav class="output directory-list" aria-label="Site navigation">
						<a href="/blog/">blog/</a>
						<a href="/about/">about/</a>
						<a href="https://github.com/linxinkenvie" target="_blank" rel="noreferrer">github/</a>
					</nav>
				</div>

				<div id="terminal-history" aria-live="polite"></div>

				<p class="hint">
					Type <strong>help</strong> or <strong>ls</strong>.
					<span>Tab completes · ↑/↓ history · Ctrl+L clears</span>
				</p>

				<form id="terminal-form" class="command current-line" autocomplete="off">
					<span class="user">linxin@whoislinxin</span><span class="separator">:</span><span class="path">~</span><span class="prompt">$</span>
					<label class="input-shell">
						<span class="sr-only">Enter a terminal command</span>
						<input
							id="terminal-input"
							class="terminal-input"
							type="text"
							placeholder=" "
							autocapitalize="off"
							spellcheck="false"
							aria-label="Terminal command"
						/>
						<span class="cursor" aria-hidden="true"></span>
					</label>
				</form>
			</section>
		</main>
	</body>
</html>

<script>
	const initializeTerminal = () => {
		const terminal = document.querySelector<HTMLElement>('.terminal');
		const form = document.querySelector<HTMLFormElement>('#terminal-form');
		const input = document.querySelector<HTMLInputElement>('#terminal-input');
		const bootOutput = document.querySelector<HTMLElement>('#boot-output');
		const historyOutput = document.querySelector<HTMLElement>('#terminal-history');

		if (!terminal || !form || !input || !bootOutput || !historyOutput) return;

		const commandHistory: string[] = [];
		let historyIndex = 0;
		const completions = [
			'help',
			'ls',
			'pwd',
			'whoami',
			'whois linxin',
			'progress',
			'cd blog',
			'cd about',
			'cd github',
			'blog',
			'about',
			'github',
			'cat about',
			'open github',
			'clear',
			'sudo',
			'rm -rf /',
			'who the fuck is linxin',
		];

		const createSpan = (className: string, text: string) => {
			const span = document.createElement('span');
			span.className = className;
			span.textContent = text;
			return span;
		};

		const appendCommand = (command: string) => {
			const row = document.createElement('div');
			row.className = 'history-command';
			row.append(
				createSpan('history-user', 'linxin@whoislinxin'),
				createSpan('history-separator', ':'),
				createSpan('history-path', '~'),
				createSpan('history-prompt', '$'),
				createSpan('history-command-text', command),
			);
			historyOutput.append(row);
		};

		const appendLines = (lines: string[], tone: 'default' | 'muted' | 'success' | 'error' = 'default') => {
			const block = document.createElement('div');
			block.className = `history-output history-${tone}`;

			for (const line of lines) {
				const row = document.createElement('div');
				row.textContent = line || '\u00a0';
				block.append(row);
			}

			historyOutput.append(block);
		};

		const appendDirectoryList = () => {
			const nav = document.createElement('nav');
			nav.className = 'history-output history-directory-list';
			nav.setAttribute('aria-label', 'Command output destinations');

			for (const destination of [
				{ label: 'blog/', href: '/blog/' },
				{ label: 'about/', href: '/about/' },
				{ label: 'github/', href: 'https://github.com/linxinkenvie', external: true },
			]) {
				const link = document.createElement('a');
				link.textContent = destination.label;
				link.href = destination.href;
				if (destination.external) {
					link.target = '_blank';
					link.rel = 'noreferrer';
				}
				nav.append(link);
			}

			historyOutput.append(nav);
		};

		const appendProgress = () => {
			const output = document.createElement('div');
			output.className = 'history-output progress-output';

			const createMeasuredRow = (
				name: string,
				value: string,
				valueNow: number,
				fillClass: string,
			) => {
				const row = document.createElement('div');
				row.className = 'progress-row';

				const label = createSpan('progress-name', name);
				const track = document.createElement('div');
				track.className = 'progress-track';
				track.setAttribute('role', 'progressbar');
				track.setAttribute('aria-label', name.toLowerCase());
				track.setAttribute('aria-valuemin', '0');
				track.setAttribute('aria-valuemax', '100');
				track.setAttribute('aria-valuenow', String(valueNow));

				const fill = document.createElement('div');
				fill.className = `progress-fill ${fillClass}`;
				track.append(fill);
				row.append(label, track, createSpan('progress-value', value));
				return row;
			};

			output.append(
				createMeasuredRow('NEW ERAS', '18%', 18, 'progress-18'),
				createMeasuredRow('ART', '1%', 1, 'progress-1'),
				createMeasuredRow('MUSIC', '0%', 0, 'progress-0'),
			);

			const lifeRow = document.createElement('div');
			lifeRow.className = 'progress-row';
			const lifeTrack = document.createElement('div');
			lifeTrack.className = 'progress-track infinite-track';
			lifeTrack.setAttribute('role', 'progressbar');
			lifeTrack.setAttribute('aria-label', 'life experience');
			lifeTrack.setAttribute('aria-valuetext', 'No end');

			const infiniteBar = document.createElement('div');
			infiniteBar.className = 'infinite-bar';
			lifeTrack.append(infiniteBar);
			lifeRow.append(
				createSpan('progress-name', 'LIFE EXPERIENCE'),
				lifeTrack,
				createSpan('progress-value no-end', 'NO END'),
			);
			output.append(lifeRow);
			historyOutput.append(output);
		};

		const navigateTo = (path: string) => {
			appendLines([`→ ${path}`], 'success');
			window.setTimeout(() => window.location.assign(path), 180);
		};

		const openGitHub = () => {
			const url = 'https://github.com/linxinkenvie';
			const newWindow = window.open(url, '_blank', 'noopener,noreferrer');
			if (newWindow) newWindow.opener = null;
			appendLines(['Opening github.com/linxinkenvie ...'], 'success');
		};

		const clearTerminal = () => {
			bootOutput.hidden = true;
			historyOutput.replaceChildren();
		};

		const longestCommonPrefix = (values: string[]) => {
			if (!values.length) return '';

			let prefix = values[0];

			for (const value of values.slice(1)) {
				while (!value.startsWith(prefix)) {
					prefix = prefix.slice(0, -1);
					if (!prefix) return '';
				}
			}

			return prefix;
		};

		const runCommand = (rawCommand: string) => {
			const normalized = rawCommand.toLowerCase().replace(/\s+/g, ' ');

			if (normalized === 'clear') {
				clearTerminal();
				return;
			}

			appendCommand(rawCommand);

			switch (normalized) {
				case 'help':
					appendLines([
						'Available commands:',
						'',
						'  whois linxin    display profile',
						'  whoami          print current user',
						'  pwd             print working directory',
						'  ls              list destinations',
						'  progress        show current progress',
						'',
						'  cd blog         open the blog',
						'  cd about        open the about page',
						'  cd github       open GitHub',
						'',
						'  clear           clear terminal',
						'',
						'Navigation aliases:',
						'  blog',
						'  about',
						'  github',
						'',
						'Keyboard:',
						'  Tab             autocomplete',
						'  ↑ / ↓           command history',
						'  Ctrl+L          clear terminal',
					]);
					break;

				case 'whois':
				case 'whois linxin':
					appendLines([
						'NAME        Linxin',
						'STATUS      Building things.',
						'INTERESTS   AI / Programming Languages / Linux',
						'DOMAIN      whoislinxin.com',
					]);
					break;

				case 'progress':
					appendProgress();
					break;

				case 'ls':
					appendDirectoryList();
					break;

				case 'pwd':
					appendLines(['/home/linxin']);
					break;

				case 'whoami':
					appendLines(['linxin']);
					break;

				case 'cat about':
					appendLines([
						'Linxin',
						'Building things with AI, programming languages, and Linux.',
						'Home: whoislinxin.com',
					]);
					break;

				case 'blog':
				case 'cd blog':
				case 'cd blog/':
					navigateTo('/blog/');
					break;

				case 'about':
				case 'cd about':
				case 'cd about/':
					navigateTo('/about/');
					break;

				case 'github':
				case 'cd github':
				case 'cd github/':
				case 'open github':
					openGitHub();
					break;

				case 'who the fuck is linxin':
					appendLines(["That's what this website is trying to figure out."]);
					break;

				case 'rm -rf /':
				case 'rm -rf --no-preserve-root /':
					appendLines([
						"rm: cannot remove '/': Read-only file system",
						'',
						"whoislinxin.com: I'm afraid I can't let you do that.",
					], 'error');
					break;

				default:
					if (normalized === 'sudo' || normalized.startsWith('sudo ')) {
						appendLines([
							'linxin is not in the sudoers file.',
							'This incident will be reported.',
							'',
							'Nice try.',
						], 'error');
						break;
					}

					appendLines([`${rawCommand}: command not found. Try 'help'.`], 'error');
			}

			historyOutput.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const command = input.value.trim();
			input.value = '';

			if (!command) return;

			commandHistory.push(command);
			historyIndex = commandHistory.length;
			runCommand(command);
		});

		input.addEventListener('keydown', (event) => {
			if (event.ctrlKey && event.key.toLowerCase() === 'l') {
				event.preventDefault();
				clearTerminal();
				return;
			}

			if (event.key === 'Enter') {
				event.preventDefault();
				form.requestSubmit();
				return;
			}

			if (event.key === 'Tab') {
				event.preventDefault();

				const value = input.value.toLowerCase();
				const matches = completions.filter((command) => command.startsWith(value));

				if (matches.length === 1) {
					input.value = matches[0];
					input.setSelectionRange(input.value.length, input.value.length);
					return;
				}

				if (matches.length > 1) {
					const prefix = longestCommonPrefix(matches);

					if (prefix.length > value.length) {
						input.value = prefix;
						input.setSelectionRange(input.value.length, input.value.length);
					} else {
						appendLines([matches.join('    ')], 'muted');
						historyOutput.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}
				}

				return;
			}

			if (event.key === 'ArrowUp') {
				event.preventDefault();
				if (!commandHistory.length) return;
				historyIndex = Math.max(0, historyIndex - 1);
				input.value = commandHistory[historyIndex] ?? '';
				input.setSelectionRange(input.value.length, input.value.length);
			}

			if (event.key === 'ArrowDown') {
				event.preventDefault();
				if (!commandHistory.length) return;
				historyIndex = Math.min(commandHistory.length, historyIndex + 1);
				input.value = commandHistory[historyIndex] ?? '';
				input.setSelectionRange(input.value.length, input.value.length);
			}
		});

		terminal.addEventListener('pointerdown', (event) => {
			if (event.target instanceof HTMLAnchorElement || event.target === input) return;
			window.requestAnimationFrame(() => input.focus({ preventScroll: true }));
		});

		if (window.matchMedia('(pointer: fine)').matches) {
			input.focus({ preventScroll: true });
		}

		form.dataset.terminalReady = 'true';
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeTerminal, { once: true });
	} else {
		initializeTerminal();
	}
</script>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #090c10;
	}

	:global(body) {
		min-height: 100vh;
		color: #d7dde5;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
	}

	.terminal-window {
		position: relative;
		width: 100%;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #090c10;
	}

	.terminal {
		position: relative;
		z-index: 2;
		width: 100%;
		box-sizing: border-box;
		padding: 72px clamp(32px, 6.5vw, 120px) 120px;
		flex: 1;
		font-size: clamp(1rem, 1.05vw, 1.2rem);
		line-height: 1.75;
	}

	.ghost-text {
		position: fixed;
		right: clamp(80px, 8vw, 160px);
		top: 50%;
		z-index: 1;
		transform: translateY(-50%);
		margin: 0;
		padding: 0;
		color: #7ee787;
		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			Menlo,
			monospace;
		font-size: clamp(0.9rem, 1.15vw, 1.3rem);
		font-weight: 700;
		line-height: 1.15;
		white-space: pre;
		pointer-events: none;
		user-select: none;
	}

	.ghost-shell {
		opacity: 0.07;
	}

	.ghost-ascii {
		opacity: 0.06;
	}

	.ghost-status {
		opacity: 0.045;
	}

	.waiting-dots {
		display: inline-block;
		width: 3ch;
	}

	.waiting-dots::after {
		content: "";
		animation: waiting-dots 2.4s steps(1, end) infinite;
	}

	.command {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		margin: 0 0 22px;
	}

	.user {
		color: #7ee787;
		font-weight: 700;
	}

	.separator {
		color: #8b949e;
	}

	.path {
		color: #79c0ff;
		font-weight: 700;
	}

	.prompt {
		color: #d2a8ff;
		margin-right: 0.65rem;
	}

	.output {
		margin: 0 0 46px;
		padding-left: 24px;
	}

	.whois-output {
		display: grid;
		gap: 10px;
	}

	:global(.progress-output) {
		display: grid;
		gap: 10px;
		max-width: 720px;
	}

	:global(.progress-row) {
		display: grid;
		grid-template-columns: 190px minmax(180px, 1fr) 70px;
		align-items: center;
		gap: 16px;
	}

	:global(.progress-name) {
		color: #8b949e;
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	:global(.progress-track) {
		position: relative;
		height: 10px;
		overflow: hidden;
		border: 1px solid #30363d;
		background: #0d1117;
	}

	:global(.progress-fill) {
		height: 100%;
		background: #7ee787;
		box-shadow: 0 0 8px rgb(126 231 135 / 0.2);
	}

	:global(.progress-18) {
		width: 18%;
	}

	:global(.progress-1) {
		width: 1%;
	}

	:global(.progress-0) {
		width: 0;
	}

	:global(.progress-value) {
		color: #79c0ff;
		text-align: right;
		white-space: nowrap;
	}

	:global(.no-end) {
		color: #d2a8ff;
	}

	:global(.infinite-bar) {
		position: absolute;
		top: 0;
		left: -28%;
		width: 28%;
		height: 100%;
		background: linear-gradient(90deg, transparent, #7ee787, transparent);
		animation: endless-progress 2.2s linear infinite;
	}

	.field {
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 20px;
	}

	.label {
		color: #8b949e;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.directory-list {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
	}

	.directory-list a {
		color: #79c0ff;
		font-weight: 700;
		text-decoration: none;
	}

	.directory-list a:hover {
		color: #a5d6ff;
		text-decoration: underline;
	}

	.hint {
		margin: 8px 0 18px;
		color: #68707c;
		font-size: 0.78em;
	}

	.hint strong {
		color: #8b949e;
	}

	.hint span {
		margin-left: 0.8em;
	}

	.current-line {
		margin-bottom: 0;
		flex-wrap: nowrap;
		cursor: text;
	}

	.input-shell {
		position: relative;
		min-width: 5rem;
		flex: 1;
		display: flex;
		align-items: center;
	}

	.terminal-input {
		width: 100%;
		min-width: 0;
		height: 1.75em;
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: #d7dde5;
		font: inherit;
		line-height: inherit;
		caret-color: #d7dde5;
	}

	.terminal-input:placeholder-shown {
		caret-color: transparent;
	}

	.terminal-input:not(:placeholder-shown) + .cursor {
		display: none;
	}

	.cursor {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.65em;
		height: 1.15em;
		display: inline-block;
		transform: translateY(-50%);
		background: #d7dde5;
		animation: blink 1s steps(1) infinite;
	}

	:global(#terminal-history .history-command) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		margin: 0 0 8px;
	}

	:global(#terminal-history .history-user) {
		color: #7ee787;
		font-weight: 700;
	}

	:global(#terminal-history .history-separator) {
		color: #8b949e;
	}

	:global(#terminal-history .history-path) {
		color: #79c0ff;
		font-weight: 700;
	}

	:global(#terminal-history .history-prompt) {
		margin-right: 0.65rem;
		color: #d2a8ff;
	}

	:global(#terminal-history .history-output) {
		margin: 0 0 30px;
		padding-left: 24px;
		white-space: pre-wrap;
	}

	:global(#terminal-history .history-directory-list) {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
	}

	:global(#terminal-history .history-directory-list a) {
